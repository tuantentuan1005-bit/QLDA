{
  "name": "hotel-care-portal-backend",
  "version": "1.0.0",
  "description": "Backend cho Hệ thống cổng chăm sóc khách hàng khách sạn",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/prisma/schema.prisma",
    "db:seed": "node src/prisma/seed.js",
    "db:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=src/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node src/prisma/seed.js"
  },
  "keywords": [],
  "author": "Nhóm HotelCarePortal",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^8.0.0-rc.19"
  }
}
