# Backend - Biến môi trường
# Sao chép file này thành .env và điền giá trị thật

# Kết nối PostgreSQL (Neon hoặc local)
DATABASE_URL="postgresql://user:password@host:5432/hotelcare?sslmode=require"

# Khóa bí mật JWT - dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Thời hạn token (7d = 7 ngày)
JWT_EXPIRES_IN="7d"

# Port backend
PORT=3000

# Frontend URL (dùng cho CORS)
CLIENT_URL="http://localhost:5173"

# Môi trường chạy
NODE_ENV="development"
